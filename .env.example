# ── Gemini ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Servidor ────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=cambia_esto_en_produccion_min_32_chars
JWT_EXPIRES_IN=8h

# ── PostgreSQL ───────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=gamma
DB_USER=gamma
DB_PASSWORD=gamma_secret_change_in_production

# ── Admin Inicial ────────────────────────────────────────
# IMPORTANTE: Cambiar estas credenciales antes de produccion
# Para deshabilitar el admin seed: ADMIN_ENABLED=false
ADMIN_ENABLED=true
ADMIN_EMAIL=admin@gamma.local
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=Administrador
